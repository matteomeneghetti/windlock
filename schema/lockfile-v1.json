{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/matteomeneghetti/windlock/main/schema/lockfile-v1.json",
  "title": "Lockfile",
  "description": "windlock.lock.yml, schema 1. Everything above platforms is the same on every host; each platform lists the archives that host downloads. windlock writes this file; see lockfile/SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "west", "container", "host_tools", "zephyr", "platforms"],
  "properties": {
    "schema": {
      "description": "The lockfile format version.",
      "type": "integer",
      "const": 1
    },
    "west": {
      "description": "The west version every entry's virtual environment installs.",
      "type": "string",
      "minLength": 1
    },
    "container": {
      "description": "The image every container-backend command runs in.",
      "$ref": "#/$defs/Container"
    },
    "host_tools": {
      "description": "Each pinned host program and its version, the same on every host.",
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "zephyr": {
      "description": "Side-by-side Zephyr revisions. The first entry is the default.",
      "type": "array",
      "items": {"$ref": "#/$defs/Zephyr"}
    },
    "platforms": {
      "description": "What each host triple downloads.",
      "type": "object",
      "propertyNames": {"enum": ["macos-aarch64", "macos-x86_64", "linux-x86_64", "linux-aarch64"]},
      "additionalProperties": {"$ref": "#/$defs/Platform"}
    }
  },
  "$defs": {
    "Container": {
      "description": "Names the image by digest, so every host runs the same one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}
      }
    },
    "Zephyr": {
      "description": "One side-by-side Zephyr revision entry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "revision", "commit", "sdk", "toolchains", "manifest_sha256", "projects", "python_inputs_sha256", "python_requirements"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "sdk": {"description": "The Zephyr SDK version the entry builds with.", "type": "string", "minLength": 1},
        "toolchains": {"type": "array", "items": {"type": "string"}},
        "manifest_sha256": {"description": "Hash of west manifest --freeze for the entry.", "type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "projects": {"type": "array", "items": {"$ref": "#/$defs/Project"}},
        "python_inputs_sha256": {"description": "Hashes the requirement files the Python pins were resolved from.", "type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "python_requirements": {"description": "The virtual environment's packages, \"name==version[ ; marker]\".", "type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "Project": {
      "description": "One west project from west manifest --freeze --active-only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "revision"],
      "properties": {
        "name": {"type": "string"},
        "path": {"type": "string"},
        "revision": {"type": "string"}
      }
    },
    "Platform": {
      "description": "What one host triple downloads.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_tools": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Archive"}},
        "sdk": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Bundle"}}
      }
    },
    "Bundle": {
      "description": "One SDK archive for a host triple.",
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "url", "sha256"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "Archive": {
      "description": "One download and its sha256.",
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  }
}
